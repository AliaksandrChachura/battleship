  "version": "1.0.0",
  "description": "Template for the WebSocket remote control task",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx ./index.ts",
    "start:dev": "tsx watch ./index.ts",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
